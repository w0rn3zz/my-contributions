+	option := call(domain.AccessRoleAdmin, http.MethodPost, "/api/v1/admin/topics/1/quiz-questions/1/options", `{"sort_order":1,"text":"Ответ","is_correct":true}`)
+	if option.Code != http.StatusCreated {
