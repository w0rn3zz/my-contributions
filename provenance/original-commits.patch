+func (s *Service) GetByIDForUser(userID, attemptID int) (domain.Attempt, error) {
+	attempt, err := s.repository.GetByID(attemptID)
+	if err != nil || attempt.UserID != userID {
+		return domain.Attempt{}, ErrAttemptNotFound
+	}
+	return attempt, nil
+}
