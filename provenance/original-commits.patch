+    category: 'Электроника',
+    dealMethod: 'delivery',
+    price: 42000,
+    currency: 'RUB',
+  },
+  mode: 'multiple_choice',
+  progress: { currentStep: 1, answeredSteps: 0, totalSteps: 2 },
+  step: {
+    id: 10,
+    number: 1,
